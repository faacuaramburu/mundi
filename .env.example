NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
# Optional public Cloudflare Web Analytics site identifier; used at build time.
VITE_CLOUDFLARE_ANALYTICS_TOKEN=
# Optional public Firebase web-app config JSON (apiKey, authDomain, projectId, appId).
# Never put a service-account key here. Accounts stay hidden until configured.
FIREBASE_WEB_CONFIG=

