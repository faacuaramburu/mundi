rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function accepted(uid) {
      return owns(uid) && verified() && exists(/databases/$(database)/documents/players/$(uid)/agreements/2026-11-01);
    }
    function validUsername(name) {
      return name is string && name.size() <= 24 && name.matches('^[a-z][a-z0-9_]{2,23}$')
        && name.matches('.*[a-z].*[a-z].*[a-z].*');
    }
    function hasUsername(data) { return data.keys().hasAny(['username']); }
    function usernameMatches(uid) {
      return (!hasUsername(request.resource.data) && (!exists(/databases/$(database)/documents/players/$(uid)) || !hasUsername(resource.data)))
        || (hasUsername(request.resource.data) && validUsername(request.resource.data.username)
          && request.resource.data.name == request.resource.data.username
          && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
          && (!exists(/databases/$(database)/documents/players/$(uid)) || !hasUsername(resource.data)
            || resource.data.username == request.resource.data.username
            || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username))));
    }
    match /players/{uid} {
      allow read: if owns(uid) && verified();
      allow create, update: if accepted(uid)
        && request.resource.data.keys().hasAll(['name', 'nameUpdatedAt', 'createdAt', 'lastSeenAt'])
        && request.resource.data.keys().hasOnly(['name', 'nameUpdatedAt', 'createdAt', 'lastSeenAt', 'username', 'publicIndex'])
        && (!request.resource.data.keys().hasAny(['publicIndex']) || request.resource.data.publicIndex is bool)
        && usernameMatches(uid)
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.nameUpdatedAt is number && request.resource.data.nameUpdatedAt >= 0
        && request.resource.data.nameUpdatedAt <= request.time.toMillis() + 60000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastSeenAt == request.time;
      match /progress/collection {
        allow read: if owns(uid) && verified();
        allow create, update: if accepted(uid)
          && request.resource.data.keys().hasAll(['discoveries', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['discoveries', 'updatedAt'])
          && request.resource.data.discoveries is map && request.resource.data.discoveries.size() <= 195
          && request.resource.data.updatedAt == request.time;
      }
      match /daily/{day} {
        allow read: if owns(uid) && verified();
        allow create, update: if accepted(uid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasAll(['day', 'guesses', 'targetId', 'won', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['day', 'guesses', 'targetId', 'won', 'updatedAt'])
          && request.resource.data.day == day
          && request.resource.data.guesses is list && request.resource.data.guesses.size() <= 195
          && request.resource.data.won is bool
          && (request.resource.data.targetId == null
            || (request.resource.data.targetId is string && request.resource.data.targetId.matches('^[A-Z]{3}$')))
          && request.resource.data.updatedAt == request.time;
      }
      match /agreements/{version} {
        allow read: if owns(uid);
        allow create: if owns(uid) && version == '2026-11-01'
          && request.resource.data.keys().hasAll(['version', 'acceptedAt'])
          && request.resource.data.keys().hasOnly(['version', 'acceptedAt', 'publicIndex'])
          && (!request.resource.data.keys().hasAny(['publicIndex']) || request.resource.data.publicIndex is bool)
          && request.resource.data.version == version && request.resource.data.acceptedAt == request.time;
      }
    }
    function published(uid, username) {
      let player = get(/databases/$(database)/documents/players/$(uid)).data;
      return player.get('publicIndex', false) == true && player.username == username;
    }
    match /usernames/{username} {
      allow get: if verified() || published(resource.data.uid, username);
      allow create: if request.auth != null && accepted(request.auth.uid) && validUsername(username)
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.username == username;
      allow delete: if verified() && resource.data.uid == request.auth.uid
        && validUsername(getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.username)
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.username != username;
    }
    function publicCountriesMatch(uid, countries) {
      let path = /databases/$(database)/documents/players/$(uid)/progress/collection;
      return (!existsAfter(path) && countries.size() == 0)
        || (existsAfter(path) && countries.toSet() == getAfter(path).data.discoveries.keys().toSet());
    }
    match /publicProfiles/{uid} {
      allow get: if (owns(uid) && verified()) || published(uid, resource.data.username);
      allow create, update: if accepted(uid)
        && request.resource.data.keys().hasAll(['username', 'countries', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['username', 'countries', 'updatedAt'])
        && validUsername(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/players/$(uid)).data.publicIndex == true
        && getAfter(/databases/$(database)/documents/players/$(uid)).data.username == request.resource.data.username
        && request.resource.data.countries is list && request.resource.data.countries.size() <= 195
        && publicCountriesMatch(uid, request.resource.data.countries)
        && request.resource.data.updatedAt == request.time;
      allow delete: if owns(uid) && verified();
    }
    // No public player directory, global reads, or client-side administration.
    match /{document=**} { allow read, write: if false; }
  }
}
